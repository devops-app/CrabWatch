{
    "name":  "crabwatch",
    "private":  true,
    "version":  "1.0.3+0022",
    "description":  "Citizen science platform for mud crab conservation in Malaysia",
    "scripts":  {
                    "dev":  "pnpm -r --parallel dev",
                    "dev:server":  "pnpm --filter=server dev",
                    "dev:web":  "pnpm --filter=web dev",
                    "dev:mobile":  "pnpm --filter=mobile dev",
                    "build":  "pnpm -r build",
                    "build:server":  "pnpm --filter=server build",
                    "build:web":  "pnpm --filter=web build",
                    "build:mobile":  "pnpm --filter=mobile build",
                    "prepare":  "git config core.hooksPath .githooks",
                    "lint":  "pnpm -r lint",
                    "lint:fix":  "pnpm -r lint:fix",
                    "typecheck":  "npx tsc --noEmit -p shared/tsconfig.json \u0026\u0026 npx tsc --noEmit -p server/tsconfig.json \u0026\u0026 npx tsc --noEmit -p web/tsconfig.json \u0026\u0026 npx tsc --noEmit -p mobile/tsconfig.json",
                    "test:e2e":  "pnpm --filter=web test:e2e",
                    "test:e2e:ui":  "pnpm --filter=web test:e2e:ui",
                    "test:e2e:headed":  "pnpm --filter=web test:e2e:headed",
                    "test:e2e:install":  "pnpm --filter=web test:e2e:install",
                    "test:e2e:setup":  "pnpm --filter=server db:seed",
                    "test:e2e:ci":  "pnpm test:e2e:setup \u0026\u0026 concurrently -k -s first \"pnpm dev:server\" \"pnpm dev:web\" \"wait-on http://localhost:3001/health \u0026\u0026 pnpm test:e2e\"",
                    "test:e2e:teardown":  "pnpm --filter=server exec prisma db drop --force \u0026\u0026 docker compose down --remove-orphans",
                    "clean":  "pnpm -r exec rm -rf node_modules dist .next",
                    "android":  "expo run:android",
                    "ios":  "expo run:ios"
                },
    "devDependencies":  {
                            "@typescript-eslint/eslint-plugin":  "^7.0.0",
                            "@typescript-eslint/parser":  "^7.0.0",
                            "concurrently":  "^8.2.2",
                            "eslint":  "^8.57.0",
                            "prettier":  "^3.3.0",
                            "typescript":  "^5.5.0",
                            "wait-on":  "^7.2.0"
                        },
    "packageManager":  "pnpm@10.33.2",
    "engines":  {
                    "node":  "\u003e=20.0.0",
                    "pnpm":  "\u003e=10.0.0"
                },
    "peerDependencies":  {
                             "expo":  "~54.0.35",
                             "react":  "19.1.4",
                             "react-native":  "0.81.6"
                         },
    "pnpm":  {
                 "overrides":  {
                                   "@babel/core":  "^7.29.6",
                                   "@fastify/busboy":  "\u003e=3.2.2",
                                   "@grpc/grpc-js":  "\u003e=1.14.5",
                                   "@opentelemetry/core":  "\u003e=2.8.0",
                                   "@opentelemetry/instrumentation-mysql":  "\u003e=0.67.0",
                                   "@opentelemetry/instrumentation-pg":  "\u003e=0.73.0",
                                   "@xmldom/xmldom@0.8":  "0.8.15",
                                   "@xmldom/xmldom@0.9":  "0.9.12",
                                   "axios":  "\u003e=1.20.0",
                                   "brace-expansion@1":  "1.1.21",
                                   "brace-expansion@2":  "2.1.7",
                                   "brace-expansion@5":  "5.0.12",
                                   "decode-uri-component":  "\u003e=0.5.0",
                                   "esbuild":  "\u003e=0.28.1",
                                   "fast-copy":  "\u003e=4.1.0",
                                   "fast-uri":  "\u003e=3.1.8",
                                   "follow-redirects":  "\u003e=1.16.1",
                                   "form-data":  "\u003e=4.0.6",
                                   "handlebars":  "\u003e=4.7.10",
                                   "image-size":  "\u003e=2.0.3",
                                   "joi":  "\u003e=18.2.9",
                                   "js-yaml":  "\u003e=5.4.1",
                                   "moment":  "\u003e=2.31.0",
                                   "morgan":  "\u003e=1.12.1",
                                   "postcss":  "\u003e=8.5.3",
                                   "postcss-selector-parser":  "\u003e=7.1.6",
                                   "protobufjs":  "\u003e=7.6.3",
                                   "proxy-addr":  "\u003e=2.0.8",
                                   "qs":  "\u003e=6.16.0",
                                   "shell-quote":  "\u003e=1.11.0",
                                   "source-map-js":  "\u003e=1.2.2",
                                   "tar":  "\u003e=7.5.16",
                                   "undici":  "6.28.1",
                                   "uuid":  "\u003e=11.1.0",
                                   "ws":  "\u003e=8.21.0"
                               },
                 "onlyBuiltDependencies":  [
                                               "@parcel/watcher",
                                               "@prisma/client",
                                               "@prisma/engines",
                                               "@scarf/scarf",
                                               "@swc/core",
                                               "bcrypt",
                                               "esbuild",
                                               "prisma",
                                               "protobufjs",
                                               "unrs-resolver"
                                           ]
             }
}