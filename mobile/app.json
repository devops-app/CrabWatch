{
    "expo":  {
                 "name":  "CrabWatch",
                 "slug":  "crabwatch",
                 "version":  "1.0.3",
                 "orientation":  "default",
                 "scheme":  "crabwatch",
                 "platforms":  [
                                   "ios",
                                   "android"
                               ],
                 "userInterfaceStyle":  "automatic",
                 "extra":  {
                               "apiUrl":  "https://crabwatch-api.azurewebsites.net/api/v1",
                               "focusSampleCooldownMs":  700,
                               "qualityGateModes":  {
                                                        "blur":  "warn",
                                                        "brightness":  "warn",
                                                        "view":  "warn",
                                                        "webcamRes":  "warn"
                                                    },
                               "eas":  {
                                           "projectId":  "2b6450de-2e8d-4d06-a12e-ef9fc444d7b7"
                                       }
                           },
                 "icon":  "./assets/icons/app-icon-1024.png",
                 "splash":  {
                                "backgroundColor":  "#0284c7"
                            },
                 "ios":  {
                             "bundleIdentifier":  "com.dsigncodehub.crabwatch",
                             "supportsTablet":  false,
                             "infoPlist":  {
                                               "ITSAppUsesNonExemptEncryption":  false,
                                               "GOOGLE_MAPS_API_KEY":  "AIzaSyByTGbC7NQ-X1wwS3cHcPby8InFYx26F58"
                                           }
                         },
                 "android":  {
                                 "icon":  "./assets/icons/app-icon-1024.png",
                                 "package":  "com.dsigncodehub.crabwatch",
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/icons/android-adaptive-foreground.png",
                                                      "backgroundColor":  "#0284c7"
                                                  },
                                 "permissions":  [
                                                     "android.permission.ACCESS_COARSE_LOCATION",
                                                     "android.permission.ACCESS_FINE_LOCATION",
                                                     "android.permission.CAMERA",
                                                     "android.permission.RECORD_AUDIO",
                                                     "android.permission.POST_NOTIFICATIONS"
                                                 ],
                                 "config":  {
                                                "googleMaps":  {
                                                                   "apiKey":  "AIzaSyByTGbC7NQ-X1wwS3cHcPby8InFYx26F58"
                                                               }
                                            }
                             },
                 "web":  {
                             "bundler":  "metro"
                         },
                 "plugins":  [
                                 [
                                     "expo-secure-store",
                                     {
                                         "configureAndroidBackup":  false
                                     }
                                 ],
                                 [
                                     "expo-location",
                                     {
                                         "locationWhenInUsePermission":  "Allow CrabWatch to use your location to tag observations."
                                     }
                                 ],
                                 [
                                     "expo-camera",
                                     {
                                         "cameraPermission":  "Allow CrabWatch to access your camera to capture crab photos."
                                     }
                                 ],
                                 [
                                     "expo-image-picker",
                                     {
                                         "cameraPermission":  "Allow CrabWatch to use your camera for crab observations.",
                                         "photosPermission":  "Allow CrabWatch to access your photo library for crab observations."
                                     }
                                 ],
                                 "expo-notifications",
                                 [
                                     "expo-build-properties",
                                     {
                                         "android":  {
                                                         "compileSdkVersion":  36,
                                                         "targetSdkVersion":  36,
                                                         "enableMinifyInReleaseBuilds":  true,
                                                         "enableShrinkResourcesInReleaseBuilds":  true,
                                                         "extraProguardRules":  "# React Native core (loaded via reflection / JSI)\n-keep class com.facebook.react.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.facebook.soloader.** { *; }\n-keep class com.facebook.proguard.annotations.DoNotStrip { *; }\n-keep class com.facebook.proguard.annotations.KeepGettersAndSetters { *; }\n-keep @com.facebook.proguard.annotations.DoNotStrip class *\n-keep @com.facebook.proguard.annotations.DoNotStrip *\n-keepclassmembers class * {\n    @com.facebook.proguard.annotations.DoNotStrip *;\n}\n-keepclassmembers class * {\n    @com.facebook.proguard.annotations.KeepGettersAndSetters *;\n}\n-keepclassmembers @com.facebook.proguard.annotations.DoNotStrip class * { *; }\n\n# react-native-reanimated / worklets\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n\n# react-native-vision-camera (native methods + reflection)\n-keep class com.mrousseau.camera2.** { *; }\n\n# Expo modules (bridge + native modules loaded via reflection)\n-keep class expo.modules.** { *; }\n\n# react-native-maps (Google Maps SDK)\n-keep class com.google.android.gms.maps.** { *; }\n\n# NitroModules (react-native-nitro-modules / nitro-image)\n-keep class com.swmansion.nitro.** { *; }\n"
                                                     }
                                     }
                                 ]
                             ],
                 "experiments":  {
                                     "tsconfigPaths":  true
                                 },
                 "owner":  "dsigncodehub"
             }
}